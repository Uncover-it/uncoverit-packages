{
  "name": "uncoverit",
  "version": "1.1.0",
  "description": "API Client for Uncover it",
  "keywords": [
    "uncoverit"
  ],
  "homepage": "https://github.com/Uncover-t/uncoverit-packages#readme",
  "bugs": {
    "url": "https://github.com/Uncover-t/uncoverit-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uncover-t/uncoverit-packages.git"
  },
  "license": "ISC",
  "author": "WarFiN123",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
