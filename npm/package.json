{
  "name": "uncoverit",
  "version": "1.3.0",
  "author": "WarFiN123",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Uncover-it/uncoverit-packages.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bugs": {
    "url": "https://github.com/Uncover-it/uncoverit-packages/issues"
  },
  "description": "API Client for Uncover it",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/Uncover-it/uncoverit-packages#readme",
  "keywords": [
    "uncoverit"
  ],
  "license": "ISC",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean && tsc --emitDeclarationOnly --declarationMap false && cp dist/index.d.ts dist/index.d.mts",
    "prepublishOnly": "bun run build"
  },
  "sideEffects": false,
  "type": "commonjs",
  "types": "./dist/index.d.ts"
}
